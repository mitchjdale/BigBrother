# --- GitHub / repo target ---
# Token used for listing issues AND for the Copilot CLI clone/auth.
# Needs Copilot Business + repo read. Falls back to `gh auth token` if unset.
GH_TOKEN=

# Repository that plans are generated against.
REPO_OWNER=mitchjdale
REPO_NAME=AdviserCentral
REPO_BASE=main

# --- Server ---
PORT=8787

# --- Planning worker ---
# How many plan jobs may run concurrently (queue admits, then runs in parallel).
PLAN_CONCURRENCY=5
# Where repos are cloned per-job (each job gets a unique subdir, deleted after).
WORK_DIR=./.work
# Copilot model for planning (omit to let Copilot auto-select).
PLAN_MODEL=
# Copilot model for execution (omit to let Copilot auto-select).
EXECUTE_MODEL=

# --- Cost capture ---
# Copilot CLI local session store (per-turn token + AIU usage lives here).
COPILOT_SESSION_STORE=~/.copilot/session-store.db
# USD per 1 AI Unit (1 AIU = 1e9 nano_aiu). Set to your negotiated rate for the
# business-case dollar figure; leave 0 to report AIU/tokens only.
USD_PER_AIU=0

# --- Data ---
SQLITE_PATH=./data/bigbrother.db
