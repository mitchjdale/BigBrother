# --- GitHub / repo target ---
# GH_TOKEN is OPTIONAL and used only for the GitHub REST API (listing issues).
# Any token kind works here (classic PAT, fine-grained PAT, or OAuth). Falls
# back to `gh auth token` if unset.
#
# NOTE: GH_TOKEN is intentionally NOT forced onto the Copilot subprocesses:
#   - Planning (Copilot CLI) rejects classic PATs (ghp_). If GH_TOKEN is a
#     classic PAT it is stripped so the CLI uses its own login. Run
#     `copilot /login` (or `gh auth login`) once so planning is authenticated.
#   - Execution (`gh agent-task`) REQUIRES an OAuth token. Run `gh auth login`
#     via the browser (OAuth) — not `--with-token` with a PAT. A non-OAuth
#     GH_TOKEN is stripped so gh falls back to your OAuth keyring credentials.
#   - Public repos clone anonymously (no token needed), so collaborators can
#     plan against them regardless of their own token scope.
GH_TOKEN=

# Repository that plans are generated against.
REPO_OWNER=mitchjdale
REPO_NAME=AdviserCentral
REPO_BASE=main
# Set true only if the target repo is private (embeds GH_TOKEN in the clone URL).
# Public repos clone anonymously.
REPO_PRIVATE=false

# --- Server ---
PORT=8787

# --- Planning worker ---
# How many plan jobs may run concurrently (queue admits, then runs in parallel).
PLAN_CONCURRENCY=5
# Where repos are cloned per-job (each job gets a unique subdir, deleted after).
WORK_DIR=./.work
# Copilot model for planning (omit to let Copilot auto-select).
PLAN_MODEL=
# Copilot model for execution (omit to let Copilot auto-select).
EXECUTE_MODEL=
# Auto-request Copilot code review after a draft PR is opened (set false to disable).
COPILOT_REVIEW=true

# --- Cost capture ---
# Copilot CLI local session store (per-turn token + AIU usage lives here).
COPILOT_SESSION_STORE=~/.copilot/session-store.db
# USD per 1 AI Unit (1 AIU = 1e9 nano_aiu). Set to your negotiated rate for the
# business-case dollar figure; leave 0 to report AIU/tokens only.
USD_PER_AIU=0
# Optional: override the rough per-model USD price list used for cost estimates
# (issue #19). JSON of { "<model>": { "input": <usd/1M tok>, "output": <usd/1M tok> } }.
# Built-in defaults are used for any model not listed here.
# MODEL_PRICING={"claude-opus-4.8":{"input":15,"output":75}}

# --- Data ---
SQLITE_PATH=./data/bigbrother.db

# --- JIRA (optional issue source) ---
# When these are set, "JIRA" becomes selectable as an issue source alongside
# GitHub Issues. Credentials stay server-side (never sent to the browser).
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL is your site, e.g. https://your-domain.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# JQL suffix appended per project when listing issues (filter + ordering).
JIRA_JQL=statusCategory != Done ORDER BY updated DESC
# Map each JIRA project to a GitHub repo (clone + PR target) on the Settings page.

# --- Logging (pino) ---
# Log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Logs are pretty-printed in development and emitted as JSON when
# NODE_ENV=production (so aggregators like Datadog/Loki/ELK can ingest stdout).
# Set LOG_PRETTY=false to force JSON in development too.
# LOG_PRETTY=false
